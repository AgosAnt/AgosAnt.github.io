---
import '@fontsource-variable/onest';
import '@fontsource-variable/martian-mono';
import '../styles/global.css';
import Muestra from '../components/Muestra.astro';

const correo = 'agozsant@gmail.com';
const github = 'https://github.com/AgosAnt';
const descripcion =
  'Jonatan Santiago, ingeniero en sistemas y desarrollador de software. Sistemas web, aplicaciones Android con operación sin conexión, aplicaciones de escritorio y despliegue en la nube.';

const servicios = [
  {
    tipo: 'sistemas',
    nombre: 'Sistemas a medida',
    texto: 'Programas web para organizar el trabajo de tu empresa: registros, reportes, planillas y accesos según el puesto de cada persona.',
    tecnico: 'React · Node.js · Spring Boot · PostgreSQL',
  },
  {
    tipo: 'movil',
    nombre: 'Aplicaciones móviles',
    texto: 'Diseño y desarrollo tu aplicación Android desde cero, según lo que tu negocio o tu idea necesiten. Puede incluir, por ejemplo:',
    caracteristicas: [
      'Solo en el teléfono',
      'Sincronización con la nube',
      'Uso sin internet',
      'Cuentas y permisos',
      'Ubicación por GPS',
    ],
    tecnico: 'Android · Java · SQLite · API REST',
  },
  {
    tipo: 'escritorio',
    nombre: 'Aplicaciones de escritorio',
    texto: 'Programas que se instalan en la computadora para manejar documentos e información interna, sin depender de un navegador.',
    tecnico: 'React · Electron · Node.js',
  },
  {
    tipo: 'nube',
    nombre: 'Nube y automatización',
    texto: 'Publico tu sistema en internet, automatizo cada actualización y dejo monitoreo para detectar fallas a tiempo.',
    tecnico: 'Docker · GitHub Actions · AWS · Azure · Grafana',
  },
] as const;

const enlaceCorreo = (asunto: string) => `mailto:${correo}?subject=${encodeURIComponent(asunto)}`;

const herramientas = [
  ['Backend', ['Spring Boot', 'Node.js', 'Maven']],
  ['Interfaces y apps', ['React', 'Electron', 'Android Studio']],
  ['Nube y operación', ['Docker', 'GitHub Actions', 'AWS: EC2, ECR, VPC', 'Azure', 'Prometheus', 'Grafana', 'Git']],
  ['Datos y documentación', ['PostgreSQL', 'Power BI', 'Mermaid']],
] as const;

---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c0c0b" />
    <title>Jonatan Santiago · Desarrollador de software</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content="Jonatan Santiago · Desarrollador de software" />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <canvas id="liquido" aria-hidden="true"></canvas>
    <a class="saltar" href="#proyectos">Saltar a los proyectos</a>

    <header class="barra" data-glass data-fijo data-radio="999">
      <a class="marca" href="#inicio" aria-label="Ir al inicio">
        <svg viewBox="0 0 32 32" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2"><path d="M15.500 4C22.500 3.500 28 8.500 28 15.500c0 3-1.500 4.500-1.500 7.500 0 3.500-5 5-10 5C9.500 28 4 24 4 16.500 4 9 8.500 4.500 15.500 4z"/><path d="M15.500 9.500c4.500-.5 8 2.500 8 6.500 0 1.500-1 2.500-1 4 0 2-3 3.500-6.500 3.500-4 0-7-2.500-7-7 0-4 2.500-6.500 6.500-7z"/></g><circle cx="16" cy="16.500" r="2.500" fill="#d9976b"/></svg>
      </a>
      <nav aria-label="Secciones">
        <span class="indicador" aria-hidden="true"></span>
        <a href="#servicios">Servicios</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#herramientas">Herramientas</a>
        <a href="#contacto">Contacto</a>
      </nav>
    </header>

    <main>
      <section id="inicio" class="heroe" data-animo="0.45">
        <h1 class="nombre">
          <span class="linea">Jonatan</span>
          <span class="linea">Santiago</span>
        </h1>
        <div class="heroe-pie">
          <div class="presentacion">
            <p class="rol">Ingeniero en Sistemas · Desarrollador de software</p>
            <p class="lema">Sistemas web, aplicaciones móviles con operación sin conexión e infraestructura en la nube.</p>
          </div>
          <div class="acciones">
            <a class="boton boton-fuerte" href="#proyectos">Ver proyectos</a>
            <a class="boton" href="#contacto">Contacto</a>
          </div>
        </div>
      </section>

      <section id="servicios" class="seccion" data-animo="0.2">
        <h2 class="titulo" data-aparecer>Servicios</h2>
        <ul class="servicios">
          {servicios.map((servicio) => {
            const { tipo, nombre, texto, tecnico } = servicio;
            return (
            <li class="servicio" data-aparecer>
              <Muestra tipo={tipo} />
              <div class="servicio-texto">
                <h3>{nombre}</h3>
                <p>{texto}</p>
                {'caracteristicas' in servicio && (
                  <ul class="caracteristicas">{servicio.caracteristicas.map((c) => <li>{c}</li>)}</ul>
                )}
                <p class="servicio-tecnico">{tecnico}</p>
                <a class="boton boton-chico" href={enlaceCorreo(`Consulta: ${nombre}`)}>¿Necesitas esto?</a>
              </div>
            </li>
            );
          })}
        </ul>
        <p class="tecnico" data-aparecer>
          <b>Soporte técnico.</b> Además del desarrollo, también puedo desempeñarme como técnico en la resolución de
          problemas de equipos y sistemas.
        </p>
        <div class="mas superficie" data-aparecer>
          <p>¿Necesitas algo más?</p>
          <a class="boton boton-fuerte boton-chico" href={enlaceCorreo('Consulta sobre otro servicio')}>Contáctame</a>
        </div>
      </section>

      <section id="proyectos" class="seccion" data-animo="0">
        <h2 class="titulo" data-aparecer>Proyectos de referencia</h2>

        <div class="proyectos superficie" data-aparecer>
          <details class="proyecto" name="proyecto">
            <summary>
              <h3>planilla-sis</h3>
              <span class="proyecto-resumen">Control de asistencia, turnos y planillas, con aplicación Android y panel web.</span>
              <span class="proyecto-accion" aria-hidden="true"></span>
            </summary>
            <div class="proyecto-detalle">
              <p>
                Los trabajadores marcan su entrada desde Android, con validación por GPS; los supervisores revisan
                las jornadas en la web y el sistema calcula el pago con las reglas del Código de Trabajo de Guatemala.
              </p>
              <p>
                Fui el líder técnico de un equipo de 6 personas. Me encargué de la arquitectura, el contrato de la API,
                la aplicación Android con su sincronización sin conexión y el despliegue en Azure.
              </p>
              <p>
                El sistema cubre 15 casos de uso, con 47 rutas de API documentadas y seguridad por fila en sus 27 tablas.
                Está hecho con React y TypeScript en la web, Node.js, Express y PostgreSQL en el servidor, y Java en Android.
              </p>
              <a class="enlace" href={`${github}/planilla-sis`} rel="noopener">Ver el código en GitHub</a>
              <details class="proyecto-demos">
                <summary>Probar dos partes del sistema</summary>
                <div class="demos">
            <div class="demo" id="demo-cola">
              <div class="demo-cabeza">
                <h4>Demostración: registro sin conexión</h4>
                <label class="interruptor">
                  <input type="checkbox" id="senal" checked />
                  <span class="riel" aria-hidden="true"></span>
                  <span id="senal-texto">Con señal</span>
                </label>
              </div>
              <p class="demo-ayuda">Desactive la señal y registre una marca. Al restablecerse, las marcas se envían en orden.</p>
              <div class="cola-botones">
                <button class="boton boton-chico boton-fuerte" id="marcar" type="button">Marcar entrada</button>
                <button class="boton boton-chico" id="reintentar" type="button" disabled>Repetir último envío</button>
              </div>
              <ol class="cola" id="cola" aria-live="polite"></ol>
              <p class="servidor">Registros en el servidor: <b id="servidor">0</b></p>
            </div>

            <form class="demo" id="demo-calculo">
              <h4>Demostración: cálculo de una quincena</h4>
              <label>
                <span>Horas por jornada <output id="s-horas">10</output></span>
                <input type="range" id="horas" min="1" max="12" step="0.5" value="10" />
              </label>
              <label>
                <span>Jornadas en la quincena <output id="s-dias">11</output></span>
                <input type="range" id="dias" min="1" max="13" value="11" />
              </label>
              <label>
                <span>Tarifa por hora <output id="s-tarifa">Q25</output></span>
                <input type="range" id="tarifa" min="15" max="80" value="25" />
              </label>
              <dl class="recibo">
                <div><dt>Horas ordinarias</dt><dd id="r-ord"></dd></div>
                <div><dt>Horas extra (× 1.5)</dt><dd id="r-ext"></dd></div>
                <div><dt>Bruto</dt><dd id="r-bruto"></dd></div>
                <div><dt>IGSS (4.83 %)</dt><dd id="r-igss"></dd></div>
                <div><dt>Bonificación Incentivo</dt><dd>Q125.00</dd></div>
                <div class="neto"><dt>Neto</dt><dd id="r-neto"></dd></div>
              </dl>
              <p class="demo-ayuda">Versión reducida para jornada diurna. Los montos son de ejemplo.</p>
            </form>
                </div>
              </details>
            </div>
          </details>

          <details class="proyecto" name="proyecto">
            <summary>
              <h3>Infraestructura DevOps con despliegue continuo</h3>
              <span class="proyecto-resumen">Cada cambio en el código se publica solo en AWS y queda monitoreado en tiempo real.</span>
              <span class="proyecto-accion" aria-hidden="true"></span>
            </summary>
            <div class="proyecto-detalle">
              <p>
                Cada push a main compila con Maven, construye la imagen Docker, la publica en Amazon ECR y la despliega
                en EC2 sin intervención manual. La infraestructura usa una VPC con subredes públicas y privadas, y
                Security Groups.
              </p>
              <p>
                La API está hecha con Java y Spring Boot. Prometheus y Grafana monitorean el servicio en tiempo real, y
                hay manifiestos de Kubernetes para orquestarlo.
              </p>
              <a class="enlace" href={`${github}/devops-pj`} rel="noopener">Ver el código en GitHub</a>
            </div>
          </details>

          <details class="proyecto" name="proyecto">
            <summary>
              <h3>Monitoreo de estrés térmico para minería</h3>
              <span class="proyecto-resumen">Cálculo de bulbo húmedo, velocidad del viento y parámetros de seguridad para personal de campo.</span>
              <span class="proyecto-accion" aria-hidden="true"></span>
            </summary>
            <div class="proyecto-detalle">
              <p>
                Aplicación de uso inmediato para personal de campo. Implementa algoritmos para calcular temperaturas de
                bulbo húmedo, velocidad del viento y parámetros de monitoreo del estrés térmico y la seguridad industrial.
              </p>
            </div>
          </details>

          <details class="proyecto" name="proyecto">
            <summary>
              <h3>Ingesta</h3>
              <span class="proyecto-resumen">Aplicación de escritorio para gestionar documentos personales y del paciente.</span>
              <span class="proyecto-accion" aria-hidden="true"></span>
            </summary>
            <div class="proyecto-detalle">
              <p>Gestión y control de documentos, tanto personales como del paciente. Está hecha con React, Electron y Node.js.</p>
              <a class="enlace" href={`${github}/Ingesta`} rel="noopener">Ver el código en GitHub</a>
            </div>
          </details>
        </div>
      </section>

      <section id="herramientas" class="seccion" data-animo="0">
        <h2 class="titulo" data-aparecer>Herramientas</h2>
        <div class="panel-herramientas" data-aparecer>
          {herramientas.map(([grupo, lista]) => (
            <div class="grupo">
              <h3>{grupo}</h3>
              <ul>{lista.map((h) => <li>{h}</li>)}</ul>
            </div>
          ))}
        </div>
      </section>

      <section id="contacto" class="seccion contacto" data-animo="0.4">
        <h2 class="titulo" data-aparecer>Contacto</h2>
        <div class="panel panel-contacto" data-glass>
          <div class="contacto-texto">
            <h3>Conversemos sobre tu proyecto</h3>
            <p>Cuéntame qué necesitas y te responderé por correo.</p>
            <div class="caminos">
              <a class="boton boton-fuerte" href={enlaceCorreo('Contacto desde el portafolio')}>Contáctame</a>
              <a class="boton" href={enlaceCorreo('Cotización de proyecto')}>Solicitar cotización</a>
            </div>
          </div>
          <dl class="contacto-datos">
            <div>
              <dt>Correo</dt>
              <dd>
                <button class="correo" id="copiar" type="button" data-correo={correo} aria-label={`Copiar el correo ${correo}`}>
                  <span id="correo-texto">{correo}</span>
                  <span class="correo-accion" aria-hidden="true">Copiar</span>
                </button>
              </dd>
            </div>
            <div>
              <dt>GitHub</dt>
              <dd><a href={github} rel="noopener">github.com/AgosAnt</a></dd>
            </div>
          </dl>
        </div>
      </section>
    </main>

    <footer class="pie">Jonatan Santiago · {new Date().getFullYear()}</footer>

    <script>
      import '../scripts/liquido.ts';
      import '../scripts/interfaz.ts';
    </script>
  </body>
</html>
